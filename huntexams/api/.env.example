# Copy to .env for local development. Every setting is prefixed with HX_.
HX_DATABASE_URL=postgresql+asyncpg://huntexams:huntexams@localhost:5432/huntexams
# Required: at least 32 random characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HX_SECRET_KEY=
# Local http needs false; production must stay true.
HX_COOKIE_SECURE=false
HX_PUBLIC_SITE_URL=http://localhost:5174
# Comma-separated emails that become admins when they sign up or log in.
HX_ADMIN_EMAILS=
# Leave empty until Google AdSense approves the site; ads stay off without it.
HX_ADSENSE_PUBLISHER_ID=
