# Required: signs login tokens. Docker Compose checks it even when you only start
# postgres and redis. Use a long random value and keep it private:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Override host ports if they clash with services already running locally.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
