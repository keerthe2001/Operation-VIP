# Copy to backend/.env for local development. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Chrome accepts Secure cookies on http://localhost, so this can stay true in dev.
COOKIE_SECURE=true

# Comma-separated; only needed when the web app is not served through the Vite proxy.
CORS_ORIGINS=

RATE_LIMIT_AUTH_PER_MINUTE=10
